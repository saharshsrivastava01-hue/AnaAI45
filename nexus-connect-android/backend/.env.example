PORT=8080
PUBLIC_BASE_URL=https://your-https-domain.example
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Comma-separated E.164 numbers explicitly approved for outbound calling
OUTBOUND_ALLOWLIST=

# Generate a long random secret. Never ship it in the Android APK.
APP_ACCESS_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local dashboard origin allowlist
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Lead store file path (default ./data/leads.json)
NEXUS_LEADS_FILE=./data/leads.json

# Application tracker JSON file (default ./data/applications.json)
NEXUS_APPLICATIONS_FILE=./data/applications.json
